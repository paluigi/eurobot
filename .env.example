# eurobot — environment configuration
# Copy to .env and fill in your keys:  cp .env.example .env

# ── LLM provider keys ─────────────────────────────────────────────
# Must match the `api_key_env` entries in config/llm-pycascade.toml.
# Only the providers you actually use in the cascade need a key.
GROQ_API_KEY=replace_me
TOGETHER_API_KEY=replace_me

# ── zzboard publishing ────────────────────────────────────────────
ZZBOARD_API_TOKEN=replace_me
ZZBOARD_API_ENDPOINT=https://roll.by.gg8.eu/api/new

# ── Optional tuning ─────────────────────────────────────────────
# Uncomment to override defaults.
#NEWS_COOLDOWN_HOURS=48     # news dedup window
#THEME_COOLDOWN_HOURS=24    # same-theme dedup window
#MAX_NEWS_ITEMS=15          # max news items presented to the LLM
#MAX_HISTORY_DAYS=90        # chart lookback window
#PIPELINE_MAX_ATTEMPTS=4    # initial run + retries before waiting for next slot
#SCHEDULE_HOURS=8,13,18     # APScheduler daily run hours (UTC)
#RUN_ON_START=1             # run the pipeline once immediately at startup

# ── Optional path overrides (rarely needed) ───────────────────────
# The container already sets these; only set them for non-Docker runs
# with a custom layout.
#EUROBOT_CONFIG_DIR=
#EUROBOT_DATA_DIR=
